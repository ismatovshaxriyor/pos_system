# Bu fayl DOCKER BUILD PAYTIDA emas, KONTEYNER ISHGA TUSHGANDA nginx:alpine
# image'ining o'rnatilgan entrypoint'i (`envsubst`) orqali qayta ishlanadi -
# `/etc/nginx/templates/*.template` dagi har qanday fayl shu tarzda
# `/etc/nginx/conf.d/`ga (`.template` kesib tashlanib) chiqariladi. Shu
# sababli BIR XIL image ikkala loyihada (cloud_server'ning umumiy marketing
# sayti VA har bir local_server/Bola'ning o'z restoran-menyu saytida) alohida
# `BACKEND_WEB` qiymati bilan qurilib ishlatiladi - ikkalasi ham xuddi shu
# Dockerfile'dan quriladi, faqat compose'dagi environment farqlanadi.
#
# Docker'ning ichki DNS'i. Bu shart: `proxy_pass` yoki `upstream` ichida
# host nomi STATIK yozilsa, nginx uni faqat boot paytida bir marta hal
# qiladi va IP'ni abadiy keshlab qoladi. `web` konteyneri deploy'da qayta
# yaratilib yangi IP olganida nginx eskisiga urinaveradi -> hamrohpos.uz/api/
# va /admin/ 502 qaytaradi. Quyida backend host o'zgaruvchi orqali berilgani
# uchun nginx DNS'ni qayta hal qiladi (valid=10s TTL bilan).
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # MobileApp.apk_file admin orqali yuklanadi (Ilovalar sahifasi) - Django
    # o'zi bu limitni qo'ymaydi, lekin nginx'ning standart 1M'i buni /admin/
    # orqali yuklashda susib qoladi (413).
    client_max_body_size 100M;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Django backend manzili. `BACKEND_WEB` konteyner env'idan (compose'dagi
    # `environment:`) `envsubst` orqali shu yerga qo'yiladi - cloud_server
    # uchun "web:8001" (Ona), local_server uchun "web:8000" (Bola); ataylab
    # ikkalasida ham HAR XIL, chunki ikki loyiha ikki xil ichki portda
    # ishlaydi (repo-root CLAUDE.md, Cloudflare ingress eslatmasiga qarang -
    # bu xato aynan port aralashib ketgani sabab 502 bergan edi). `$request_uri`
    # ham shart: o'zgaruvchili proxy_pass'da nginx original URI'ni avtomatik
    # uzatmaydi.
    set $backend_web "${BACKEND_WEB}";

    # DIQQAT: `X-Forwarded-Proto $scheme` YOZILMASIN - `$scheme` shu nginx'ga
    # KELGAN ulanishning sxemasi (har doim "http", chunki `listen 80` va TLS
    # Cloudflare chekkasida tugaydi), mijozning HAQIQIY sxemasi emas. Bu buni
    # doim "http" deb Django'ga uzatib, `request.build_absolute_uri()` orqali
    # qurilgan har qanday havolani (masalan MobileApp.apk_file yuklab olish
    # linki) noto'g'ri `http://` bilan chiqargan - Android ba'zi brauzerlari
    # .apk kabi fayllarni cleartext (http) orqali yuklashni butunlay
    # rad etadi. Bu konteyner FAQAT Cloudflare tunnel orqali ochiladi (public
    # port yo'q), shuning uchun qattiq "https" yozish xavfsiz va to'g'ri.

    # SPA Fallback - client-side routing (/, /ilovalar, /table/<uuid>/) shu
    # orqali ishlaydi, chunki haqiqatda bitta index.html bor.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to Django backend (local_server: /api/public/*,
    # cloud_server: /api/sync/*).
    location /api/ {
        proxy_pass http://$backend_web$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Proxy Admin requests to Django backend
    location /admin/ {
        proxy_pass http://$backend_web$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Django admin static files
    location /static/ {
        proxy_pass http://$backend_web$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Media fayllar (masalan MobileApp.apk_file, Product/Category rasmlari) -
    # backend'ning o'zi xizmat qiladi (local_server/cloud_server ikkalasi ham
    # /media/<path> route'iga ega).
    location /media/ {
        proxy_pass http://$backend_web$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Real-vaqt WebSocket kanali (local_server/core/routing.py::EventsConsumer,
    # `ws/events/?token=...&device_id=...`) - shu bo'lmasa xodim ilovalari
    # (masalan admin) faqat REST API'ni emas, real-vaqt push'ni ham
    # restoran WiFi'sidan tashqarida ololmas edi. `$request_uri` shart -
    # token/device_id query parametrda keladi. cloud_server WSGI (Channels
    # yo'q) - bu location o'sha deployda shunchaki hech qachon ishlatilmaydi.
    location /ws/ {
        proxy_pass http://$backend_web$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Default 60s - WS ulanishi uzoq bo'sh turishi mumkin (real-vaqt
        # push kutib), nginx uni muddatidan oldin uzib qo'ymasligi kerak.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
