{
  "expo": {
    "name": "POS Xodim",
    "slug": "pos-staff",
    "version": "1.2.3",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "posstaff",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Restoran tizimini WiFi tarmog'ida topish uchun kerak.",
        "NSBonjourServices": [
          "_pos-bola._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F1F1E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uz.hamrohpos.staff"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F1F1E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Menyu va restoran rasmlarini tanlash uchun galereyaga ruxsat kerak."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Litsenziya QR kodini skanerlash uchun kamera kerak.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Restoran joylashuvini belgilash va davomat uchun joylashuv kerak."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dfbac59a-5e00-4d83-93fd-8c0689fdccca"
      }
    },
    "owner": "shaxa000"
  }
}
